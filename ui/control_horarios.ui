<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner">
  <project>
    <settings />
    <customwidgets />
    <resources />
  </project>
  <object class="ttk.Frame" id="app" named="True">
    <property name="padding">10</property>
    <containerlayout manager="grid">
      <property type="column" id="0" name="weight">1</property>
      <property type="row" id="0" name="weight">1</property>
    </containerlayout>
    <child>
      <object class="ttk.Notebook" id="pestanas" named="True">
        <layout manager="grid">
          <property name="row">0</property>
          <property name="column">0</property>
          <property name="sticky">nsew</property>
        </layout>
        <child>
          <object class="ttk.Notebook.Tab" id="tab_registro" named="True">
            <property name="text">Fichaje / Registro</property>
            <child>
              <object class="ttk.Frame" id="pantalla_registro" named="True">
                <property name="padding">14</property>
                <containerlayout manager="grid">
                  <property type="column" id="0" name="weight">1</property>
                  <property type="row" id="2" name="weight">1</property>
                </containerlayout>
                <child>
                  <object class="ttk.Label" id="titulo_registro" named="True">
                    <property name="text">Registro de Jornada Laboral</property>
                    <layout manager="grid">
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">0</property>
                      <property name="pady">0 12</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Labelframe" id="datos_empleado" named="True">
                    <property name="text">Datos del empleado</property>
                    <property name="padding">14</property>
                    <layout manager="grid">
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">nsew</property>
                    </layout>
                    <containerlayout manager="grid">
                      <property type="column" id="1" name="weight">1</property>
                    </containerlayout>
                    <child>
                      <object class="ttk.Label" id="etiqueta_id_empleado" named="True">
                        <property name="text">ID de empleado *</property>
                        <layout manager="grid">
                          <property name="row">0</property>
                          <property name="column">0</property>
                          <property name="sticky">w</property>
                          <property name="padx">4 10</property>
                          <property name="pady">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Entry" id="id_empleado" named="True">
                        <property name="width">32</property>
                        <layout manager="grid">
                          <property name="row">0</property>
                          <property name="column">1</property>
                          <property name="sticky">ew</property>
                          <property name="padx">4</property>
                          <property name="pady">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Label" id="etiqueta_nombre" named="True">
                        <property name="text">Nombre completo *</property>
                        <layout manager="grid">
                          <property name="row">1</property>
                          <property name="column">0</property>
                          <property name="sticky">w</property>
                          <property name="padx">4 10</property>
                          <property name="pady">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Entry" id="nombre_completo" named="True">
                        <property name="width">32</property>
                        <layout manager="grid">
                          <property name="row">1</property>
                          <property name="column">1</property>
                          <property name="sticky">ew</property>
                          <property name="padx">4</property>
                          <property name="pady">6</property>
                        </layout>
