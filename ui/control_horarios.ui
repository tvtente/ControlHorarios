<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner">
  <project>
    <settings />
    <customwidgets />
    <resources />
  </project>
  <object class="ttk.Frame" id="app" named="True">
    <property name="padding">10</property>
    <containerlayout manager="grid">
      <property type="column" id="0" name="weight">1</property>
      <property type="row" id="0" name="weight">1</property>
    </containerlayout>
    <child>
      <object class="ttk.Notebook" id="pestanas" named="True">
        <layout manager="grid">
          <property name="row">0</property>
          <property name="column">0</property>
          <property name="sticky">nsew</property>
        </layout>
        <child>
          <object class="ttk.Notebook.Tab" id="tab_registro" named="True">
            <property name="text">Fichaje / Registro</property>
            <child>
              <object class="ttk.Frame" id="contenedor_registro" named="True" />
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Notebook.Tab" id="tab_panel" named="True">
            <property name="text">Panel de Control</property>
            <child>
              <object class="ttk.Frame" id="contenedor_panel" named="True" />
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Notebook.Tab" id="tab_historico" named="True">
            <property name="text">Histórico Excel</property>
            <child>
              <object class="ttk.Frame" id="contenedor_historico" named="True" />
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>