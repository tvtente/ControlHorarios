                          <property name="row">6</property>
                          <property name="column">1</property>
                          <property name="sticky">ew</property>
                          <property name="padx">4</property>
                          <property name="pady">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Label" id="aviso_fecha_hora" named="True">
                        <property name="text">La fecha y la hora del fichaje se registran automáticamente</property>
                        <layout manager="grid">
                          <property name="row">7</property>
                          <property name="column">0</property>
                          <property name="sticky">w</property>
                          <property name="padx">4 10</property>
                          <property name="pady">12 4</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="ttk.Frame" id="acciones_registro" named="True">
                    <layout manager="grid">
                      <property name="row">3</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="pady">10 0</property>
                    </layout>
                    <containerlayout manager="grid">
                      <property type="column" id="0" name="weight">1</property>
                      <property type="column" id="1" name="weight">1</property>
                    </containerlayout>
                    <child>
                      <object class="ttk.Button" id="registrar_fichaje" named="True">
                        <property name="command" type="command" cbtype="simple">guardar_registro</property>
                        <property name="text">Registrar fichaje</property>
