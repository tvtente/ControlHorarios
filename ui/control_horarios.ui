                    </child>
                    <child>
                      <object class="ttk.Label" id="etiqueta_departamento" named="True">
                        <property name="text">Departamento</property>
                        <layout manager="grid">
                          <property name="row">2</property>
                          <property name="column">0</property>
                          <property name="sticky">w</property>
                          <property name="padx">4 10</property>
                          <property name="pady">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Combobox" id="departamento" named="True">
                        <property name="width">32</property>
                        <property name="state">readonly</property>
                        <property name="values">{Reservas y Emisión} {Atención al Cliente} {Operaciones} {Recursos Humanos} {Administración}</property>
                        <layout manager="grid">
                          <property name="row">2</property>
                          <property name="column">1</property>
                          <property name="sticky">ew</property>
                          <property name="padx">4</property>
                          <property name="pady">6</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="ttk.Label" id="etiqueta_accion" named="True">
