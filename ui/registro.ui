                    <property name="style">RegistroInputIcon.TLabel</property>
                    <property name="text" />
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="padx">0</property>
                      <property name="row">0</property>
                    </layout>
                    <property name="padding">10 7</property>
                    <property name="image">../images/reloj_24.png</property>
                  </object>
                </child>
                <child>
                  <object class="ttk.Spinbox" id="hora_fin_prevista" named="True">
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="row">0</property>
                      <property name="sticky">ew</property>
                    </layout>
                    <property name="width">8</property>
                    <property name="justify">left</property>
                    <property name="wrap">true</property>
                    <property name="style">Registro.TSpinbox</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="datos_observaciones" named="True">
        <property name="padding">12</property>
        <property name="style">RegistroPanel.TFrame</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">14 0</property>
          <property name="row">2</property>
          <property name="sticky">ew</property>
        </layout>
        <containerlayout manager="grid">
          <property type="column" id="0" name="weight">1</property>
        </containerlayout>
        <child>
          <object class="ttk.Frame" id="encabezado_observaciones" named="True">
            <property name="style">RegistroCard.TFrame</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="pady">0 4</property>
              <property name="row">0</property>
              <property name="sticky">ew</property>
            </layout>
            <containerlayout manager="grid">
              <property type="column" id="1" name="weight">1</property>
            </containerlayout>
            <child>
              <object class="ttk.Label" id="icono_observaciones" named="True">
                <property name="style">RegistroCardIcon.TLabel</property>
                <property name="text" />
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0 10</property>
                  <property name="row">0</property>
                  <property name="rowspan">2</property>
                </layout>
                <property name="padding">10 8</property>
                <property name="image">../images/observaciones.png</property>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="etiqueta_observaciones" named="True">
                <property name="style">RegistroCardTitle.TLabel</property>
                <property name="text" translatable="yes">Observaciones</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">0</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="subtitulo_observaciones" named="True">
                <property name="style">RegistroCardSubtitle.TLabel</property>
                <property name="text" translatable="yes">Información adicional sobre el registro</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="pady">2 0</property>
                  <property name="row">1</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Frame" id="fila_observaciones" named="True">
            <property name="style">RegistroInput.TFrame</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="pady">0 6</property>
              <property name="row">1</property>
              <property name="sticky">ew</property>
            </layout>
            <containerlayout manager="grid">
              <property type="column" id="1" name="weight">1</property>
            </containerlayout>
            <child>
              <object class="ttk.Label" id="icono_texto_observaciones" named="True">
                <property name="style">RegistroInputIcon.TLabel</property>
                <property name="text" />
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0</property>
                  <property name="row">0</property>
                </layout>
                <property name="padding">10 7</property>
                <property name="image">../images/observaciones_24.png</property>
              </object>
            </child>
            <child>
              <object class="tk.Text" id="observaciones" named="True">
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">0</property>
                  <property name="sticky">ew</property>
                </layout>
                <property name="height">2</property>
                <property name="width">60</property>
                <property name="wrap">word</property>
                <property name="background">#FFFFFF</property>
                <property name="foreground">#172554</property>
                <property name="relief">flat</property>
                <property name="borderwidth">0</property>
                <property name="padx">10</property>
                <property name="pady">4</property>
                <property name="highlightthickness">0</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="aviso_fecha_hora" named="True">
            <property name="style">RegistroNotice.TLabel</property>
            <property name="text" translatable="yes">ⓘ   La fecha y la hora del fichaje se registran automáticamente.</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">2</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="acciones_registro" named="True">
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">14 0</property>
          <property name="row">3</property>
          <property name="sticky">ew</property>
        </layout>
        <containerlayout manager="grid">
          <property type="column" id="0" name="weight">1</property>
          <property type="column" id="1" name="weight">1</property>
          <property type="column" id="0" name="uniform">registro_columnas</property>
          <property type="column" id="1" name="uniform">registro_columnas</property>
        </containerlayout>
        <child>
          <object class="ttk.Button" id="registrar_fichaje" named="True">
            <property name="command" type="command" cbtype="simple">guardar_registro</property>
            <property name="style">Primary.TButton</property>
            <property name="text" translatable="yes">Registrar fichaje</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">0 8</property>
              <property name="row">0</property>
              <property name="sticky">ew</property>
            </layout>
            <property name="image">../images/reloj_24.png</property>
            <property name="compound">left</property>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="limpiar_formulario" named="True">
            <property name="command" type="command" cbtype="simple">limpiar_formulario</property>
            <property name="style">Secondary.TButton</property>
            <property name="text" translatable="yes">Limpiar</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">8 0</property>
              <property name="row">0</property>
              <property name="sticky">ew</property>
            </layout>
            <property name="image">../images/limpiar_24.png</property>
            <property name="compound">left</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>