<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings />
    <customwidgets />
    <resources />
  </project>
  <object class="ttk.Frame" id="pantalla_registro" named="True">
    <property name="padding">14</property>
    <layout manager="grid" />
    <containerlayout manager="grid">
      <property type="column" id="0" name="weight">1</property>
      <property type="row" id="2" name="weight">1</property>
    </containerlayout>
    <child>
      <object class="ttk.Label" id="titulo_registro" named="True">
        <property name="font">{Segoe UI} 16 {bold}</property>
        <property name="foreground">#12306B</property>
        <property name="text" translatable="yes">Registro de Jornada Laboral</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">0</property>
          <property name="pady">0 12</property>
          <property name="row">0</property>
          <property name="sticky">w</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Labelframe" id="datos_empleado" named="True">
        <property name="labelanchor">nw</property>
        <property name="padding">14</property>
        <property name="text" translatable="yes">Datos del empleado</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">1</property>
          <property name="sticky">nsew</property>
        </layout>
        <containerlayout manager="grid">
          <property type="column" id="1" name="weight">1</property>
        </containerlayout>
        <child>
          <object class="ttk.Label" id="etiqueta_id_empleado" named="True">
            <property name="font">{Segoe UI} 10 {bold}</property>
            <property name="foreground">#26354D</property>
            <property name="text" translatable="yes">ID de empleado *</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">4 10</property>
              <property name="pady">6</property>
              <property name="row">0</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="id_empleado" named="True">
            <property name="width">32</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">4</property>
              <property name="pady">6</property>
              <property name="row">0</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="etiqueta_nombre" named="True">
            <property name="font">{Segoe UI} 10 {bold}</property>
            <property name="foreground">#26354D</property>
            <property name="text" translatable="yes">Nombre completo *</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">4 10</property>
              <property name="pady">6</property>
              <property name="row">1</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="nombre_completo" named="True">
            <property name="width">32</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">4</property>
              <property name="pady">6</property>
              <property name="row">1</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="etiqueta_departamento" named="True">
            <property name="font">{Segoe UI} 10 {bold}</property>
            <property name="foreground">#26354D</property>
            <property name="text" translatable="yes">Departamento</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">4 10</property>
              <property name="pady">6</property>
              <property name="row">2</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Combobox" id="departamento" named="True">
            <property name="state">readonly</property>
            <property name="values">{Reservas y Emisión} {Atención al Cliente} {Operaciones} {Recursos Humanos} {Administración}</property>
            <property name="width">32</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">4</property>
              <property name="pady">6</property>
              <property name="row">2</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="etiqueta_accion" named="True">
            <property name="font">{Segoe UI} 10 {bold}</property>
            <property name="foreground">#26354D</property>
            <property name="text" translatable="yes">Tipo de registro</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">4 10</property>
              <property name="pady">6</property>
              <property name="row">3</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Combobox" id="accion" named="True">
            <property name="state">readonly</property>
            <property name="values">{Entrada a Turno} {Salida de Turno} {Inicio de Descanso} {Fin de Descanso}</property>
            <property name="width">32</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">4</property>
              <property name="pady">6</property>
              <property name="row">3</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="etiqueta_inicio_previsto" named="True">
            <property name="font">{Segoe UI} 10 {bold}</property>
            <property name="foreground">#26354D</property>
            <property name="text" translatable="yes">Inicio previsto (HH:MM)</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">4 10</property>
              <property name="pady">6</property>
              <property name="row">4</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="hora_inicio_prevista" named="True">
            <property name="width">32</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">4</property>
              <property name="pady">6</property>
              <property name="row">4</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="etiqueta_fin_previsto" named="True">
            <property name="font">{Segoe UI} 10 {bold}</property>
            <property name="foreground">#26354D</property>
            <property name="text" translatable="yes">Fin previsto (HH:MM)</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">4 10</property>
              <property name="pady">6</property>
              <property name="row">5</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="hora_fin_prevista" named="True">
            <property name="width">32</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">4</property>
              <property name="pady">6</property>
              <property name="row">5</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="etiqueta_observaciones" named="True">
            <property name="font">{Segoe UI} 10 {bold}</property>
            <property name="foreground">#26354D</property>
            <property name="text" translatable="yes">Observaciones</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">4 10</property>
              <property name="pady">6</property>
              <property name="row">6</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="observaciones" named="True">
            <property name="width">32</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">4</property>
              <property name="pady">6</property>
              <property name="row">6</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="aviso_fecha_hora" named="True">
            <property name="font">{Segoe UI} 9 {}</property>
            <property name="foreground">#2563EB</property>
            <property name="text" translatable="yes">La fecha y la hora del fichaje se registran automáticamente</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">4 10</property>
              <property name="pady">12 4</property>
              <property name="row">7</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="acciones_registro" named="True">
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">10 0</property>
          <property name="row">3</property>
          <property name="sticky">ew</property>
        </layout>
        <containerlayout manager="grid">
          <property type="column" id="0" name="weight">1</property>
          <property type="column" id="1" name="weight">1</property>
        </containerlayout>
        <child>
          <object class="ttk.Button" id="registrar_fichaje" named="True">
            <property name="command" type="command" cbtype="simple">guardar_registro</property>
            <property name="style">Primary.TButton</property>
            <property name="text" translatable="yes">Registrar fichaje</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">5</property>
              <property name="pady">7</property>
              <property name="row">0</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="limpiar_formulario" named="True">
            <property name="command" type="command" cbtype="simple">limpiar_formulario</property>
            <property name="style">Secondary.TButton</property>
            <property name="text" translatable="yes">Limpiar</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">5</property>
              <property name="pady">7</property>
              <property name="row">0</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="estado_registro" named="True">
        <property name="text" translatable="yes">Completa los datos y registra un fichaje</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">0</property>
          <property name="pady">8 0</property>
          <property name="row">4</property>
          <property name="sticky">w</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
