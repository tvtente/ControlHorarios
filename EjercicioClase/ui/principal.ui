<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner">
  <project><settings /><customwidgets /><resources /></project>
  <object class="ttk.Frame" id="aplicacion" named="True">
    <property name="padding">10</property>
    <containerlayout manager="grid"><property type="column" id="0" name="weight">1</property><property type="row" id="0" name="weight">1</property></containerlayout>
    <child>
      <object class="ttk.Notebook" id="pestanas" named="True">
        <bind sequence="&lt;&lt;NotebookTabChanged&gt;&gt;" handler="al_cambiar_pestana" add="" />
        <layout manager="grid"><property name="row">0</property><property name="column">0</property><property name="sticky">nsew</property></layout>
        <child><object class="ttk.Notebook.Tab" id="tab_formulario" named="True"><property name="text">Formulario</property><child><object class="ttk.Frame" id="contenedor_formulario" named="True" /></child></object></child>
        <child><object class="ttk.Notebook.Tab" id="tab_tabla" named="True"><property name="text">Tabla de personas</property><child><object class="ttk.Frame" id="contenedor_tabla" named="True" /></child></object></child>
      </object>
    </child>
  </object>
</interface>
